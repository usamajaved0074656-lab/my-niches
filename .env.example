# Copy this file to .env and fill in your project's values.
# Jab tak ye khali hain, app data/niches.json istemaal karti hai.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret)
# Ye key server-side hi rehti hai, browser tak kabhi nahi jati.
SUPABASE_KEY=eyJhbGciOi...

# Optional
PORT=5173
