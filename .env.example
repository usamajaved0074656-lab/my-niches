# Copy this file to .env and fill in your own values.
# Leave SUPABASE_URL and SUPABASE_KEY out (or empty) to keep the data in
# data/niches.json on this PC instead.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (starts with sb_secret_)
# It stays on the server and never reaches the browser.
SUPABASE_KEY=sb_secret_...

# Optional
PORT=5173

# Optional: how often, in hours, the app checks every saved channel for YouTube
# takedowns and moves them into "Removed by YouTube". 0 turns the check off.
# SWEEP_HOURS=24
